<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Unscripted6160 · Heartbeat of America Tour</title>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html,body{background:#3b393a;color:#e8e0d0;font-family:Georgia,'Times New Roman',serif;min-height:100vh}
::-webkit-scrollbar{width:6px}::-webkit-scrollbar-track{background:#3b393a}::-webkit-scrollbar-thumb{background:#555052;border-radius:3px}
input,select,textarea,button{font-family:inherit}
button:hover{opacity:.85}
#header{background:linear-gradient(180deg,#2e2c2d 0%,#3b393a 100%);border-bottom:1px solid #484344;padding:22px 24px 0;position:sticky;top:0;z-index:20}
#title-row{display:flex;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;gap:8px;margin-bottom:2px}
h1{font-size:clamp(20px,3.5vw,30px);font-weight:normal;color:#f0e8d8;line-height:1.1}
h1 span{color:#e63946}
h2{font-size:11px;font-weight:normal;color:#a08878;letter-spacing:3px;text-transform:uppercase;margin-top:2px}
#stats{display:flex;gap:12px;font-family:'Courier New',monospace;font-size:11px;color:#a89898;flex-wrap:wrap;align-items:flex-end}
#ekg-svg{width:100%;height:46px;display:block}
.tabs{display:flex;gap:0;border-bottom:1px solid #484344;margin-top:6px}
.tab{background:transparent;border:none;border-bottom:2px solid transparent;color:#b0a8a8;padding:8px 18px;font-family:'Courier New',monospace;font-size:11px;cursor:pointer;letter-spacing:2px;text-transform:uppercase;transition:color .15s}
.tab:hover{color:#e8e0d0}
.tab.active{color:#e63946;border-bottom-color:#e63946}
.tab.active-routes{color:#2a9d8f;border-bottom-color:#2a9d8f}
#toolbar{display:flex;gap:6px;flex-wrap:wrap;padding:8px 0 10px;align-items:center;border-top:1px solid #3b393a}
.tb{background:transparent;border:1px solid #555052;border-radius:3px;padding:4px 11px;font-size:10px;font-family:'Courier New',monospace;cursor:pointer;letter-spacing:.5px}
.tb-teal{color:#2a9d8f;border-color:#2a9d8f}
.tb-orange{color:#f4a261}
.tb-orange:hover{border-color:#f4a261}
.tb-red{color:#ff7070}
.tb-red:hover{border-color:#ff7070}
#save-msg{font-family:'Courier New',monospace;font-size:10px;color:#2a9d8f}
#auto-info{margin-left:auto;font-family:'Courier New',monospace;font-size:9px;color:#a89898}
#filter-bar{display:flex;gap:6px;flex-wrap:wrap;padding:8px 24px 10px;background:#363334;border-bottom:1px solid #484344}
.f-search{background:#3b393a;border:1px solid #666063;border-radius:3px;color:#e8e0d0;padding:5px 10px;font-size:12px;font-family:'Courier New',monospace;outline:none;flex:1;min-width:130px}
.f-search::placeholder{color:#a89898}
.f-search:focus{border-color:#e63946}
.flt{background:transparent;border:1px solid #555052;border-radius:3px;color:#c8bfbf;padding:4px 10px;font-size:10px;font-family:'Courier New',monospace;cursor:pointer;letter-spacing:.5px}
.flt.act-all{color:#e63946;border-color:#e63946;background:#e6394612}
.flt.act-trail{color:#e63946;border-color:#e63946;background:#e6394612}
.flt.act-connection{color:#f4a261;border-color:#f4a261;background:#f4a26112}
.flt.act-poi{color:#2a9d8f;border-color:#2a9d8f;background:#2a9d8f12}
.flt-sel{background:#3b393a;border:1px solid #555052;border-radius:3px;color:#c8bfbf;padding:4px 8px;font-size:10px;font-family:'Courier New',monospace;outline:none;cursor:pointer}
.flt-sel:focus{border-color:#e63946}
#add-panel{display:none;background:#0d2a24;border-bottom:1px solid #2a9d8f;padding:16px 24px}
#add-panel.open{display:block}
#add-panel-title{font-size:9px;letter-spacing:3px;color:#2a9d8f;font-family:'Courier New',monospace;margin-bottom:10px}
.form-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:8px;margin-bottom:10px}
.form-grid .full{grid-column:1/-1}
.form-lbl{font-size:9px;color:#406050;font-family:'Courier New',monospace;margin-bottom:3px;letter-spacing:1px}
.form-ctrl{background:#142a22;border:1px solid #2a6050;border-radius:3px;color:#e8e0d0;padding:5px 9px;font-size:11px;font-family:'Courier New',monospace;outline:none;width:100%}
.form-ctrl:focus{border-color:#2a9d8f}
textarea.form-ctrl{resize:vertical;line-height:1.5}
.btn-add{background:#0d2a24;border:1px solid #2a9d8f;border-radius:3px;color:#2a9d8f;padding:6px 18px;font-size:11px;font-family:'Courier New',monospace;cursor:pointer}
.btn-cancel{background:transparent;border:1px solid #484344;border-radius:3px;color:#a89898;padding:6px 14px;font-size:11px;font-family:'Courier New',monospace;cursor:pointer}
#content{padding:10px 24px 60px}
.no-results{text-align:center;color:#806868;font-family:'Courier New',monospace;font-size:12px;padding:60px}
.entry{margin-bottom:2px}
.erow{display:flex;align-items:center;gap:8px;padding:8px 12px;border-radius:0 3px 3px 0;cursor:pointer;transition:background .1s}
.erow:hover{filter:brightness(1.1)}
.eseq{font-size:9px;font-family:'Courier New',monospace;color:#b0a8a8;min-width:20px;flex-shrink:0}
.eicon{font-size:12px;flex-shrink:0}
.estate{font-size:8px;letter-spacing:1px;padding:1px 5px;border-radius:2px;flex-shrink:0;font-family:'Courier New',monospace;min-width:26px;text-align:center}
.ename{flex:1;font-size:13px;color:#f0e8d8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.eregion{font-size:8px;color:#b0a8a8;font-family:'Courier New',monospace;flex-shrink:0;white-space:nowrap;max-width:90px;overflow:hidden;text-overflow:ellipsis}
.epri{font-size:8px;font-family:'Courier New',monospace;padding:1px 5px;border-radius:2px;flex-shrink:0}
.pri-a{background:#e6394618;color:#ff7070;border:1px solid #e6394640}
.pri-b{background:#f4a26118;color:#f4a261;border:1px solid #f4a26140}
.pri-c{background:#44cc7718;color:#44cc77;border:1px solid #44cc7740}
.emiles{font-size:11px;font-family:'Courier New',monospace;flex-shrink:0}
.emiles span{font-size:8px;color:#b0a8a8}
.ekg-sym{font-size:10px;flex-shrink:0;font-family:'Courier New',monospace}
.ekg-up2{color:#ff4444}.ekg-up1{color:#ff8844}.ekg-flat{color:#44cc77}.ekg-down1{color:#44aaff}.ekg-down2{color:#4466ff}
.user-badge{font-size:7px;color:#2a9d8f;border:1px solid #2a9d8f;border-radius:2px;padding:1px 3px;font-family:'Courier New',monospace;flex-shrink:0}
.edetail{padding:10px 16px 14px 46px;border-radius:0 0 4px 0}
.detail-meta{display:flex;flex-wrap:wrap;gap:6px 20px;margin-bottom:10px;font-family:'Courier New',monospace;font-size:10px}
.dk{color:#706060}.dv{color:#c8b0a0}
.detail-notes{font-size:12px;color:#a09080;line-height:1.7;margin:0 0 10px}
.scores-section{margin-bottom:10px}
.score-row{display:flex;align-items:center;gap:6px;margin-bottom:3px}
.score-lbl{font-size:8px;color:#806868;font-family:'Courier New',monospace;width:72px;letter-spacing:.5px}
.dot{width:7px;height:7px;border-radius:50%;display:inline-block;margin-right:1px}
.dot.on{}
.dot.off{opacity:.18}
.mustdo-title{font-size:8px;letter-spacing:2px;color:#2a9d8f;font-family:'Courier New',monospace;margin-bottom:5px}
.mustdo-item{display:flex;gap:7px;margin-bottom:2px}
.mustdo-dot{color:#2a9d8f;font-size:10px}
.mustdo-text{font-size:11px;color:#c8b8a0}
.tags-section{display:flex;flex-wrap:wrap;gap:4px;margin-bottom:8px}
.tag{font-size:8px;color:#907888;font-family:'Courier New',monospace;border:1px solid #554555;border-radius:2px;padding:1px 6px}
.dactions{display:flex;gap:7px;margin-top:8px}
.btn-ins{background:transparent;border:1px solid #2a4a40;border-radius:2px;color:#2a9d8f;font-size:9px;font-family:'Courier New',monospace;padding:3px 9px;cursor:pointer}
.btn-rem{background:transparent;border:1px solid #5a4040;border-radius:2px;color:#ff7070;font-size:9px;font-family:'Courier New',monospace;padding:3px 9px;cursor:pointer}
.routes-grid{display:flex;flex-direction:column;gap:6px}
.rcard{border-radius:4px;overflow:hidden;cursor:pointer;background:#363334}
.rchead{display:flex;align-items:center;gap:12px;padding:13px 16px;transition:background .12s}
.rchead:hover{background:#3f3c3d}
.rchead.open{background:#3a3336}
.rcicon{font-size:16px;flex-shrink:0}
.rcinfo{flex:1;min-width:0}
.rcname{font-size:14px;color:#f0e8d8}
.rcdesc{font-size:10px;color:#a09080;margin-top:2px;line-height:1.4}
.rcstats{text-align:right;font-family:'Courier New',monospace;font-size:10px;color:#b0a8a8;flex-shrink:0;white-space:nowrap}
.rcseq{padding:8px 16px 14px 44px;background:#312e2f}
.rcseq-item{display:flex;align-items:center;gap:8px;padding:4px 0;border-bottom:1px solid #3f3a3b}
.rcseq-item:last-child{border-bottom:none}
.rcseq-icon{font-size:11px;flex-shrink:0}
.rcseq-state{font-size:8px;font-family:'Courier New',monospace;min-width:22px;flex-shrink:0}
.rcseq-name{flex:1;font-size:11px;color:#c8b8a8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.rcseq-miles{font-size:10px;font-family:'Courier New',monospace;color:#907060;flex-shrink:0}
.rcseq-missing{font-size:10px;color:#606060;font-family:'Courier New',monospace;padding:4px 0}
#route-panel{display:none;background:#0d2a24;border-bottom:1px solid #2a9d8f;padding:16px 24px}
#route-panel.open{display:block}
#route-panel-title{font-size:9px;letter-spacing:3px;color:#2a9d8f;font-family:'Courier New',monospace;margin-bottom:10px}
.rcseq-actions{display:flex;gap:8px;padding-bottom:10px;margin-bottom:8px;border-bottom:1px solid #3f3a3b}
.rc-edit-btn{background:transparent;border:1px solid #2a4a40;border-radius:2px;color:#2a9d8f;font-size:9px;font-family:'Courier New',monospace;padding:3px 10px;cursor:pointer}
.rc-del-btn{background:transparent;border:1px solid #5a4040;border-radius:2px;color:#ff7070;font-size:9px;font-family:'Courier New',monospace;padding:3px 10px;cursor:pointer}
.rcbtns{display:flex;gap:3px;margin-left:auto;flex-shrink:0}
.rcbtn{background:transparent;border:1px solid #555052;border-radius:2px;color:#c8bfbf;font-size:9px;font-family:'Courier New',monospace;padding:1px 7px;cursor:pointer;line-height:1.5}
.rcbtn:hover{border-color:#e63946;color:#e63946}
.rcbtn:disabled{opacity:.2;cursor:default}
.rcbtn:disabled:hover{border-color:#555052;color:#c8bfbf}
.rcadd-row{display:flex;gap:6px;padding-top:12px;margin-top:8px;border-top:1px solid #3f3a3b}
.rcadd-sel{flex:1;background:#3b393a;border:1px solid #555052;border-radius:3px;color:#e8e0d0;padding:5px 8px;font-size:11px;font-family:'Courier New',monospace;outline:none}
.rcadd-sel:focus{border-color:#2a9d8f}
.rcadd-btn{background:#0d2a24;border:1px solid #2a9d8f;border-radius:3px;color:#2a9d8f;padding:5px 14px;font-size:10px;font-family:'Courier New',monospace;cursor:pointer;flex-shrink:0}
#footer{border-top:1px solid #484344;padding:14px 24px;font-family:'Courier New',monospace;font-size:9px;color:#a89898;display:flex;justify-content:space-between;flex-wrap:wrap;gap:4px}
</style>
</head>
<body>
<div id="header">
  <div id="title-row">
    <div>
      <div style="font-size:9px;letter-spacing:4px;color:#e63946;font-family:'Courier New',monospace;margin-bottom:3px">WEST &#x2192; EAST &nbsp;·&nbsp; TOUR DESIGN DATABASE</div>
      <h1>Unscripted<span>6160</span></h1>
      <h2>Heartbeat of America Tour</h2>
    </div>
    <div id="stats">
      <span><b id="st-t" style="color:#e63946">0</b> trails</span>
      <span><b id="st-c" style="color:#f4a261">0</b> links</span>
      <span><b id="st-p" style="color:#2a9d8f">0</b> POIs</span>
      <span><b id="st-m" style="color:#e8e0d0">0</b> mi</span>
      <span><b id="st-n" style="color:#c8bfbf">0</b> entries</span>
    </div>
  </div>
  <svg id="ekg-svg" viewBox="0 0 1000 70" xmlns="http://www.w3.org/2000/svg">
    <polyline points="0,35 70,35 90,8 110,62 130,15 160,55 195,35 255,35 280,8 310,58 340,18 380,35 420,35 455,10 490,60 520,22 560,35 600,35 635,5 680,68 715,18 755,35 800,35 835,12 870,52 905,30 1000,35"
      fill="none" stroke="rgba(230,57,70,0.15)" stroke-width="9" stroke-linejoin="round" stroke-linecap="round"/>
    <polyline points="0,35 70,35 90,8 110,62 130,15 160,55 195,35 255,35 280,8 310,58 340,18 380,35 420,35 455,10 490,60 520,22 560,35 600,35 635,5 680,68 715,18 755,35 800,35 835,12 870,52 905,30 1000,35"
      fill="none" stroke="#e63946" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>
  </svg>
  <div class="tabs">
    <button class="tab active" id="tab-lib" onclick="setTab('library')">&#9776; Library</button>
    <button class="tab" id="tab-rts" onclick="setTab('routes')">&#9654; Routes</button>
  </div>
  <div id="toolbar">
    <button class="tb tb-teal" id="btn-add-entry" onclick="openAddEntry()">+ Add Entry</button>
    <button class="tb tb-teal" id="btn-new-route" onclick="openNewRoute()" style="display:none">+ New Route</button>
    <button class="tb tb-orange" onclick="exportJSON()">&#8595; Export JSON</button>
    <label class="tb tb-orange" style="cursor:pointer">&#8593; Import JSON<input type="file" accept=".json" onchange="importJSON(event)" style="display:none"/></label>
    <button class="tb tb-red" onclick="resetData()">&#8635; Reset</button>
    <span id="save-msg"></span>
    <span id="auto-info">Auto-saved &middot; <span id="st-n2">0</span> entries</span>
  </div>
</div>
<div id="filter-bar">
  <input id="f-search" class="f-search" type="text" placeholder="Search trails, states, themes&#8230;" oninput="setSearch(this.value)"/>
  <button class="flt act-all" data-f="all" onclick="setFType('all')">All</button>
  <button class="flt" data-f="trail" onclick="setFType('trail')">Trails</button>
  <button class="flt" data-f="connection" onclick="setFType('connection')">Links</button>
  <button class="flt" data-f="poi" onclick="setFType('poi')">Must See</button>
  <select class="flt-sel" id="f-region" onchange="setFRegion(this.value)">
    <option value="">All Regions</option>
  </select>
  <select class="flt-sel" id="f-priority" onchange="setFPriority(this.value)">
    <option value="">All Priority</option>
    <option value="A">Priority A</option>
    <option value="B">Priority B</option>
    <option value="C">Priority C</option>
  </select>
  <select class="flt-sel" id="f-theme" onchange="setFTheme(this.value)">
    <option value="">All Themes</option>
    <option value="railroad">Railroad</option>
    <option value="waterway">Waterway / Canal</option>
    <option value="national-park">National Park</option>
    <option value="civil-war">Civil War</option>
    <option value="revolutionary-war">Revolutionary War</option>
    <option value="westward-expansion">Westward Expansion</option>
    <option value="native-american-history">Native American History</option>
    <option value="industrial">Industrial Heritage</option>
    <option value="coastal">Coastal</option>
    <option value="mountains">Mountains</option>
    <option value="river-corridor">River Corridor</option>
    <option value="small-town-america">Small Town America</option>
    <option value="colonial-history">Colonial History</option>
    <option value="scenic-byway">Scenic Byway</option>
  </select>
</div>
<div id="add-panel">
  <div id="add-panel-title">ADD ENTRY <span id="add-after-label"></span></div>
  <div class="form-grid">
    <div>
      <div class="form-lbl">TYPE *</div>
      <select id="a-type" class="form-ctrl" onchange="toggleAddFields()">
        <option value="trail">Trail</option>
        <option value="connection">Connection</option>
        <option value="poi">Must See / POI</option>
      </select>
    </div>
    <div style="grid-column:span 2">
      <div class="form-lbl">NAME *</div>
      <input id="a-name" class="form-ctrl" placeholder="Name"/>
    </div>
    <div>
      <div class="form-lbl">STATE(S)</div>
      <input id="a-state" class="form-ctrl" placeholder="e.g. PA / MD"/>
    </div>
    <div>
      <div class="form-lbl">REGION (type new or pick existing)</div>
      <input id="a-region" class="form-ctrl" placeholder="e.g. Southern Rockies" list="region-suggestions"/>
      <datalist id="region-suggestions"></datalist>
    </div>
    <div id="a-trailtype-wrap">
      <div class="form-lbl">TRAIL TYPE</div>
      <input id="a-trailtype" class="form-ctrl" placeholder="e.g. Rail Trail"/>
    </div>
    <div id="a-miles-wrap">
      <div class="form-lbl">MILES</div>
      <input id="a-miles" type="number" class="form-ctrl" placeholder="0"/>
    </div>
    <div id="a-surface-wrap">
      <div class="form-lbl">SURFACE</div>
      <input id="a-surface" class="form-ctrl" placeholder="e.g. Paved"/>
    </div>
    <div id="a-ekg-wrap">
      <div class="form-lbl">EKG ROLE</div>
      <select id="a-ekg" class="form-ctrl">
        <option value="up2">&#8593;&#8593; Major spike (N)</option>
        <option value="up1">&#8593; Moderate spike</option>
        <option value="flat" selected>&#8212; Baseline</option>
        <option value="down1">&#8595; Moderate dip</option>
        <option value="down2">&#8595;&#8595; Major dip (S)</option>
      </select>
    </div>
    <div id="a-priority-wrap">
      <div class="form-lbl">PRIORITY</div>
      <select id="a-priority" class="form-ctrl">
        <option value="A">A — Must Consider</option>
        <option value="B" selected>B — Worthwhile</option>
        <option value="C">C — Optional</option>
      </select>
    </div>
    <div id="a-category-wrap" style="display:none">
      <div class="form-lbl">CATEGORY</div>
      <input id="a-category" class="form-ctrl" placeholder="e.g. Historic Site"/>
    </div>
    <div class="full">
      <div class="form-lbl">NOTES / DESCRIPTION</div>
      <textarea id="a-notes" class="form-ctrl" rows="2" placeholder="Description, highlights, tips&#8230;"></textarea>
    </div>
    <div id="a-mustdo-wrap" class="full" style="display:none">
      <div class="form-lbl">MUST-DO ITEMS (separate with semicolons)</div>
      <input id="a-mustdo" class="form-ctrl" placeholder="Summit hike; Visitor center; Sunrise viewpoint"/>
    </div>
    <div class="full" id="a-insert-wrap">
      <div class="form-lbl">INSERT AFTER (optional)</div>
      <select id="a-insert" class="form-ctrl">
        <option value="">&#x2014; Append to end &#x2014;</option>
      </select>
    </div>
  </div>
  <div style="display:flex;gap:8px">
    <button class="btn-add" id="a-submit-btn" onclick="submitAdd()">Add to Library</button>
    <button class="btn-cancel" onclick="closeAdd()">Cancel</button>
  </div>
</div>
<div id="route-panel">
  <div id="route-panel-title">NEW ROUTE</div>
  <div class="form-grid">
    <div class="full">
      <div class="form-lbl">ROUTE NAME *</div>
      <input id="r-name" class="form-ctrl" placeholder="e.g. Lewis and Clark Edition"/>
    </div>
    <div class="full">
      <div class="form-lbl">DESCRIPTION</div>
      <textarea id="r-desc" class="form-ctrl" rows="2" placeholder="What makes this route version unique&#8230;"></textarea>
    </div>
    <div>
      <div class="form-lbl">ICON (emoji or symbol)</div>
      <input id="r-icon" class="form-ctrl" placeholder="e.g. &#9733;" maxlength="2"/>
    </div>
    <div>
      <div class="form-lbl">COLOR</div>
      <input id="r-color" class="form-ctrl" type="color" value="#e63946" style="height:30px;padding:2px;cursor:pointer"/>
    </div>
  </div>
  <div style="display:flex;gap:8px">
    <button class="btn-add" onclick="submitRoute()" id="route-submit-btn">Create Route</button>
    <button class="btn-cancel" onclick="closeRoutePanel()">Cancel</button>
  </div>
</div>
<div id="content"></div>
<div id="footer">
  <span>Sources: Rails-to-Trails Conservancy &middot; Adventure Cycling Association &middot; NPS &middot; TrailLink</span>
  <span>Unscripted6160 Heartbeat of America Tour &middot; Tour Design Database v2 &middot; Auto-saved locally</span>
</div>

function slugify(s){
  return s.toLowerCase().trim().replace(/[^a-z0-9]+/g,'-').replace(/(^-|-$)/g,'') || ('route-'+Date.now());
}
function slugifyRegion(s){
  return String(s||'').toLowerCase().trim().replace(/[^a-z0-9]+/g,'-').replace(/(^-|-$)/g,'');
}
function regionLabel(slug){
  if(!slug) return '';
  if(REGION_LABELS[slug]) return REGION_LABELS[slug];
  return slug.split('-').map(w=>w.charAt(0).toUpperCase()+w.slice(1)).join(' ');
}
function getAllRegionSlugs(){
  const s = new Set(Object.keys(REGION_LABELS));
  lib.forEach(it=>{ if(it.region) s.add(it.region); });
  return Array.from(s);
}


  const priEl = item.priority ? `<span class="epri ${priCls}">${item.priority}</span>` : '';
  const regionEl = regionLbl ? `<span class="eregion">${esc(regionLbl)}</span>` : '';
  const ekgEl = ekg ? `<span class="ekg-sym ${ekg.cls}">${ekg.sym}</span>` : '';
  const milesEl = item.miles ? `<span class="emiles" style="color:${cfg.color}">${item.miles}<span>mi</span></span>` : '';
  const userEl = item.userAdded ? '<span class="user-badge">NEW</span>' : '';

  let detail = '';
  if(isOpen){
    // meta
    const meta = [
      item.trailType ? `<span><span class="dk">TYPE </span><span class="dv">${esc(item.trailType)}</span></span>` : '',
      item.surface&&item.surface.length ? `<span><span class="dk">SURFACE </span><span class="dv">${esc(item.surface.join(', '))}</span></span>` : '',
      item.status    ? `<span><span class="dk">STATUS </span><span class="dv">${esc(item.status)}</span></span>` : '',
      item.category  ? `<span><span class="dk">CATEGORY </span><span class="dv">${esc(item.category)}</span></span>` : '',
      item.difficulty? `<span><span class="dk">DIFFICULTY </span><span class="dv">${'●'.repeat(item.difficulty)}${'○'.repeat(5-item.difficulty)}</span></span>` : '',
      ekg ? `<span><span class="dk">EKG </span><span class="${ekg.cls}">${ekg.sym} ${ekg.label}</span></span>` : '',
      item.routeGroups&&item.routeGroups.length ? `<span><span class="dk">ROUTES </span><span class="dv">${esc(item.routeGroups.join(', '))}</span></span>` : '',
    ].filter(Boolean).join('');

    // scores
    const scores = SCORE_CFG
      .filter(s=>!s.trailOnly||item.type==='trail')
      .filter(s=>item[s.key]!==undefined)
      .map(s=>`<div class="score-row"><span class="score-lbl">${s.label}</span>${scoreDots(item[s.key],s.color)}</div>`)
      .join('');

    // mustDo
    const mustdo = (item.mustDo&&item.mustDo.length)
      ? `<div class="mustdo-title">MUST DO / SEE</div>`
        + item.mustDo.map(d=>`<div class="mustdo-item"><span class="mustdo-dot">&#9670;</span><span class="mustdo-text">${esc(d)}</span></div>`).join('')
      : '';

    // tags + themes
    const allTags = [...(item.themes||[]),...(item.tags||[])];
    const tagsHtml = allTags.length ? `<div class="tags-section">${allTags.map(t=>`<span class="tag">${esc(t)}</span>`).join('')}</div>` : '';

    detail = `<div class="edetail" style="background:${cfg.bg};border-left:3px solid ${cfg.color}">
      <div class="detail-meta">${meta}</div>
      ${scores ? `<div class="scores-section">${scores}</div>` : ''}
      ${item.notes?`<p class="detail-notes">${esc(item.notes)}</p>`:''}
      ${mustdo}
      ${tagsHtml}
      <div class="dactions">
        <button class="btn-ins" onclick="event.stopPropagation();openEditEntryForm('${item.id}')">Edit</button>
        <button class="btn-ins" onclick="event.stopPropagation();doInsertAfter('${item.id}')">Insert After</button>
        <button class="btn-rem" onclick="event.stopPropagation();doRemove('${item.id}')">Remove</button>
      </div>
    </div>`;
  }

  return `<div class="entry type-${item.type}" id="entry-${item.id}">
    <div class="erow${isOpen?' open':''}" style="border-left:3px solid ${cfg.color};background:${isOpen?cfg.bg:'transparent'}" onclick="toggleExpand('${item.id}')">
      ${seqNum}
      <span class="eicon" style="color:${cfg.color}">${cfg.icon}</span>
      ${stateBadge}
      <span class="ename">${esc(item.name)}</span>
      ${regionEl}
      ${priEl}
      ${ekgEl}
      ${milesEl}
      ${userEl}
    </div>
    ${detail}
  </div>`;
}

// ── RENDER ROUTE CARD ─────────────────────────────────────────────
function renderRouteCard(routeId, routeDef){
  const isOpen = expandedRouteId === routeId;
  const col = routeDef.color || '#e63946';
  const ids = routeDef.ids||[];
  const resolved = ids.map(id=>({id,item:lib.find(e=>e.id===id)}));
  const found = resolved.filter(x=>x.item);
  const trails = found.filter(x=>x.item.type==='trail');
  const totalMiles = found.filter(x=>x.item.miles).reduce((s,x)=>s+(x.item.miles||0),0);

  let seq = '';
  if(isOpen){
    const missingCount = resolved.length - found.length;
    const seqRows = found.length ? found.map((x,idx)=>{
      const cfg = TYPE_CFG[x.item.type]||TYPE_CFG.trail;
      return `<div class="rcseq-item">
        <span class="rcseq-icon" style="color:${cfg.color}">${cfg.icon}</span>
        <span class="rcseq-state" style="color:${cfg.color}">${esc(x.item.state)}</span>
        <span class="rcseq-name">${esc(x.item.name)}</span>
        ${x.item.miles?`<span class="rcseq-miles">${x.item.miles}mi</span>`:''}
        <span class="rcbtns">
          <button class="rcbtn" onclick="moveRouteEntry('${routeId}','${x.id}',-1)" ${idx===0?'disabled':''}>&#9650;</button>
          <button class="rcbtn" onclick="moveRouteEntry('${routeId}','${x.id}',1)" ${idx===found.length-1?'disabled':''}>&#9660;</button>
          <button class="rcbtn" onclick="removeRouteEntry('${routeId}','${x.id}')" style="color:#ff7070;border-color:#5a4040">&#10005;</button>
        </span>
      </div>`;
    }).join('') : '<div class="rcseq-missing">No entries yet — add some from the library below.</div>';

    const availableOptions = lib
      .filter(e=>!ids.includes(e.id))
      .slice().sort((a,b)=>a.name.localeCompare(b.name))
      .map(e=>`<option value="${e.id}">${esc(e.name)} (${esc(e.state)})</option>`)
      .join('');

    seq = `<div class="rcseq">
      <div class="rcseq-actions">
        <button class="rc-edit-btn" onclick="openEditRoute('${routeId}')">Edit Info</button>
        <button class="rc-del-btn" onclick="deleteRoute('${routeId}')">Delete Route</button>
      </div>
      ${seqRows}
      ${missingCount?`<div class="rcseq-missing">+ ${missingCount} unresolved reference(s) — entry may have been removed from the library</div>`:''}
      <div class="rcadd-row">
        <select class="rcadd-sel" id="rcadd-${routeId}">${availableOptions}</select>
        <button class="rcadd-btn" onclick="addRouteEntry('${routeId}')">+ Add to Route</button>
      </div>
    </div>`;
  }

  return `<div class="rcard">
    <div class="rchead${isOpen?' open':''}" style="border-left:4px solid ${col}" onclick="toggleExpandRoute('${routeId}')">
      <span class="rcicon" style="color:${col}">${esc(routeDef.icon||'●')}</span>
      <div class="rcinfo">
        <div class="rcname">${esc(routeDef.name)}</div>
        <div class="rcdesc">${esc(routeDef.description||'')}</div>
      </div>
      <div class="rcstats">${trails.length} trails<br>${totalMiles.toLocaleString()} mi</div>
    </div>
    ${seq}
  </div>`;
}

// ── RENDER MAIN ───────────────────────────────────────────────────
function render(){
  saveData();
  saveRoutes();
  // stats
  const trails = lib.filter(r=>r.type==='trail');
  const conns  = lib.filter(r=>r.type==='connection');
  const pois   = lib.filter(r=>r.type==='poi');
  const miles  = lib.filter(r=>r.miles).reduce((s,r)=>s+(r.miles||0),0);
  document.getElementById('st-t').textContent = trails.length;
  document.getElementById('st-c').textContent = conns.length;
  document.getElementById('st-p').textContent = pois.length;
  document.getElementById('st-m').textContent = miles.toLocaleString();
  document.getElementById('st-n').textContent = lib.length;
  document.getElementById('st-n2').textContent = lib.length;

  // insert dropdown
  const ins = document.getElementById('a-insert');
  const prev = ins.value;
  ins.innerHTML = '<option value="">&#x2014; Append to end &#x2014;</option>'
    + lib.map((r,i)=>`<option value="${r.id}">${String(i+1).padStart(2,'0')} · ${esc(r.name)} (${esc(r.state)})</option>`).join('');
  if(prev) ins.value=prev;

  // region filter dropdown — built dynamically from whatever regions actually exist
  const regionSel = document.getElementById('f-region');
  const curRegionVal = regionSel.value;
  const allSlugs = getAllRegionSlugs().sort((a,b)=>regionLabel(a).localeCompare(regionLabel(b)));
  regionSel.innerHTML = '<option value="">All Regions</option>'
    + allSlugs.map(s=>`<option value="${esc(s)}">${esc(regionLabel(s))}</option>`).join('');
  if(allSlugs.includes(curRegionVal)){ regionSel.value=curRegionVal; } else { regionSel.value=''; filters.region=''; }

  // region datalist suggestions for the add/edit form
  const dl = document.getElementById('region-suggestions');
  dl.innerHTML = allSlugs.map(s=>`<option value="${esc(regionLabel(s))}"></option>`).join('');

  // tab states
  document.getElementById('tab-lib').className = 'tab' + (activeTab==='library'?' active':'');
  document.getElementById('tab-rts').className = 'tab' + (activeTab==='routes'?' active-routes':'');

  // filter bar visibility
  document.getElementById('filter-bar').style.display = activeTab==='library'?'flex':'none';

  // toolbar button visibility
  document.getElementById('btn-add-entry').style.display = activeTab==='library'?'':'none';
  document.getElementById('btn-new-route').style.display = activeTab==='routes'?'':'none';

  const content = document.getElementById('content');

  if(activeTab==='library'){
    const items = getFiltered();
    if(!items.length){
      content.innerHTML='<div class="no-results">No entries match your filter.</div>';
      return;
    }
    content.innerHTML = items.map((item,i)=>renderEntry(item,i,false)).join('');
  } else {
    // routes tab
    const routeIds = Object.keys(routes);
    if(!routeIds.length){
      content.innerHTML = '<div class="no-results">No routes yet. Click "+ New Route" above to build your first one.</div>';
      return;
    }
    content.innerHTML = `<div class="routes-grid">${routeIds.map(id=>renderRouteCard(id,routes[id])).join('')}</div>`;
  }
}

// ── INTERACTIONS ──────────────────────────────────────────────────
function setTab(t){
  activeTab=t; expandedId=null; expandedRouteId=null; render();
}
function toggleExpand(id){
  expandedId = expandedId===id?null:id;
  render();
}
function toggleExpandRoute(id){
  expandedRouteId = expandedRouteId===id?null:id;
  render();
}
function setFType(v){
  filters.type=v;
  document.querySelectorAll('.flt').forEach(b=>{
    const f=b.dataset.f;
    b.className='flt'+(f===v?' act-'+v:'');
  });
  render();
}
function setSearch(q){ filters.search=q; expandedId=null; render(); }
function setFRegion(v){ filters.region=v; render(); }
function setFPriority(v){ filters.priority=v; render(); }
function setFTheme(v){ filters.theme=v; render(); }

function doInsertAfter(id){
  editEntryId=null;
  insertAfterId=id;
  const name=lib.find(r=>r.id===id)?.name||id;
  document.getElementById('add-panel-title').textContent='ADD ENTRY';
  document.getElementById('add-after-label').textContent=`(after: ${name})`;
  document.getElementById('a-submit-btn').textContent='Add to Library';
  document.getElementById('a-insert-wrap').style.display='';
  clearAddForm();
  document.getElementById('a-insert').value=id;
  addOpen=true;
  document.getElementById('add-panel').classList.add('open');
  window.scrollTo({top:0,behavior:'smooth'});
}
function doRemove(id){
  if(!confirm('Remove this entry from the library?')) return;
  lib=lib.filter(r=>r.id!==id);
  if(expandedId===id) expandedId=null;
  render();
}

// ── ROUTE EDITOR ──────────────────────────────────────────────────
function openNewRoute(){
  routeEditMode = null;
  document.getElementById('route-panel-title').textContent = 'NEW ROUTE';
  document.getElementById('route-submit-btn').textContent = 'Create Route';
  document.getElementById('r-name').value = '';
  document.getElementById('r-desc').value = '';
  document.getElementById('r-icon').value = '\u2605';
  document.getElementById('r-color').value = '#e63946';
  document.getElementById('route-panel').classList.add('open');
  window.scrollTo({top:0,behavior:'smooth'});
}
function openEditRoute(routeId){
  routeEditMode = routeId;
  const r = routes[routeId];
  document.getElementById('route-panel-title').textContent = 'EDIT ROUTE INFO';
  document.getElementById('route-submit-btn').textContent = 'Save Changes';
  document.getElementById('r-name').value = r.name||'';
  document.getElementById('r-desc').value = r.description||'';
  document.getElementById('r-icon').value = r.icon||'\u2605';
  document.getElementById('r-color').value = r.color||'#e63946';
  document.getElementById('route-panel').classList.add('open');
  window.scrollTo({top:0,behavior:'smooth'});
}
function closeRoutePanel(){
  routeEditMode = null;
  document.getElementById('route-panel').classList.remove('open');
}
function submitRoute(){
  const name = document.getElementById('r-name').value.trim();
  if(!name){ alert('Route name is required.'); return; }
  const desc  = document.getElementById('r-desc').value.trim();
  const icon  = document.getElementById('r-icon').value.trim() || '\u2605';
  const color = document.getElementById('r-color').value || '#e63946';

  if(routeEditMode){
    routes[routeEditMode].name = name;
    routes[routeEditMode].description = desc;
    routes[routeEditMode].icon = icon;
    routes[routeEditMode].color = color;
    closeRoutePanel(); render();
    flashMsg('\u2713 Route updated');
  } else {
    let id = slugify(name), suffix = 1;
    while(routes[id]){ id = slugify(name)+'-'+(++suffix); }
    routes[id] = {name, description:desc, icon, color, ids:[]};
    expandedRouteId = id;
    closeRoutePanel(); render();
    flashMsg('\u2713 Route created — start adding entries below');
  }
}
function deleteRoute(routeId){
  const name = routes[routeId]?.name || routeId;
  if(!confirm('Delete the route "'+name+'"? This only removes the route definition — library entries are untouched.')) return;
  delete routes[routeId];
  if(expandedRouteId===routeId) expandedRouteId=null;
  render();
  flashMsg('\u2713 Route deleted');
}
function addRouteEntry(routeId){
  const sel = document.getElementById('rcadd-'+routeId);
  const id = sel.value;
  if(!id) return;
  if(!routes[routeId].ids.includes(id)) routes[routeId].ids.push(id);
  render();
}
function removeRouteEntry(routeId, entryId){
  routes[routeId].ids = routes[routeId].ids.filter(x=>x!==entryId);
  render();
}
function moveRouteEntry(routeId, entryId, dir){
  const ids = routes[routeId].ids;
  const idx = ids.indexOf(entryId);
  const newIdx = idx + dir;
  if(newIdx<0 || newIdx>=ids.length) return;
  [ids[idx], ids[newIdx]] = [ids[newIdx], ids[idx]];
  render();
}

// ── ADD FORM ──────────────────────────────────────────────────────
function openAddEntry(){
  editEntryId=null;
  insertAfterId=null;
  document.getElementById('add-panel-title').textContent='ADD ENTRY';
  document.getElementById('add-after-label').textContent='';
  document.getElementById('a-submit-btn').textContent='Add to Library';
  document.getElementById('a-insert-wrap').style.display='';
  clearAddForm();
  addOpen=true;
  document.getElementById('add-panel').classList.add('open');
}
function openEditEntryForm(id){
  const item = lib.find(r=>r.id===id);
  if(!item) return;
  editEntryId=id;
  insertAfterId=null;
  document.getElementById('add-panel-title').textContent='EDIT ENTRY';
  document.getElementById('add-after-label').textContent='— '+item.name;
  document.getElementById('a-submit-btn').textContent='Save Changes';
  document.getElementById('a-insert-wrap').style.display='none';

  document.getElementById('a-type').value = item.type||'trail';
  document.getElementById('a-name').value = item.name||'';
  document.getElementById('a-state').value = item.state||'';
  document.getElementById('a-region').value = regionLabel(item.region);
  document.getElementById('a-trailtype').value = item.trailType||'';
  document.getElementById('a-miles').value = item.miles||'';
  document.getElementById('a-surface').value = (item.surface&&item.surface.length)?item.surface.join(', '):'';
  document.getElementById('a-ekg').value = item.ekg||'flat';
  document.getElementById('a-priority').value = item.priority||'B';
  document.getElementById('a-category').value = item.category||'';
  document.getElementById('a-notes').value = item.notes||'';
  document.getElementById('a-mustdo').value = (item.mustDo&&item.mustDo.length)?item.mustDo.join('; '):'';

  toggleAddFields();
  addOpen=true;
  document.getElementById('add-panel').classList.add('open');
  window.scrollTo({top:0,behavior:'smooth'});
}
function closeAdd(){
  addOpen=false; insertAfterId=null; editEntryId=null;
  document.getElementById('add-panel').classList.remove('open');
  clearAddForm();
}
function toggleAddFields(){
  const t=document.getElementById('a-type').value;
  document.getElementById('a-miles-wrap').style.display    = t==='poi'?'none':'';
  document.getElementById('a-surface-wrap').style.display  = t==='poi'?'none':'';
  document.getElementById('a-trailtype-wrap').style.display= t==='trail'?'':'none';
  document.getElementById('a-ekg-wrap').style.display      = t==='trail'?'':'none';
  document.getElementById('a-category-wrap').style.display = t==='poi'?'':'none';
  document.getElementById('a-mustdo-wrap').style.display   = t==='poi'?'':'none';
}
function clearAddForm(){
  ['a-name','a-state','a-region','a-trailtype','a-miles','a-surface','a-notes','a-mustdo','a-category'].forEach(id=>{
    document.getElementById(id).value='';
  });
  document.getElementById('a-type').value='trail';
  document.getElementById('a-ekg').value='flat';
  document.getElementById('a-priority').value='B';
  document.getElementById('a-insert').value='';
  toggleAddFields();
}
function submitAdd(){
  const name=document.getElementById('a-name').value.trim();
  if(!name){alert('Name is required.');return;}
  const type=document.getElementById('a-type').value;
  const miles=document.getElementById('a-miles').value;
  const mustDoRaw=document.getElementById('a-mustdo').value;
  const regionRaw=document.getElementById('a-region').value.trim();

  const fields = {
    type, name,
    state: document.getElementById('a-state').value.trim()||'—',
    region: regionRaw ? slugifyRegion(regionRaw) : '',
    notes: document.getElementById('a-notes').value.trim()||'',
    priority: document.getElementById('a-priority').value||'B',
  };
  if(type!=='poi'){
    fields.miles = miles?Number(miles):undefined;
    const surf=document.getElementById('a-surface').value.trim();
    fields.surface = surf?surf.split(',').map(s=>s.trim()).filter(Boolean):undefined;
  } else {
    fields.miles=undefined; fields.surface=undefined;
  }
  if(type==='trail'){
    fields.ekg=document.getElementById('a-ekg').value;
    const tt=document.getElementById('a-trailtype').value.trim();
    fields.trailType = tt||undefined;
  } else {
    fields.ekg=undefined; fields.trailType=undefined;
  }
  if(type==='poi'){
    const cat=document.getElementById('a-category').value.trim();
    fields.category = cat||undefined;
    fields.mustDo = mustDoRaw?mustDoRaw.split(';').map(s=>s.trim()).filter(Boolean):undefined;
  } else {
    fields.category=undefined; fields.mustDo=undefined;
  }

  if(editEntryId){
    const idx=lib.findIndex(r=>r.id===editEntryId);
    if(idx>-1){
      lib[idx] = Object.assign({}, lib[idx], fields, {id:lib[idx].id, userAdded:lib[idx].userAdded});
    }
    closeAdd(); render();
    flashMsg('\u2713 Updated: '+name);
  } else {
    const newItem = Object.assign(
      {id:'user-'+(++nextId), themes:[], tags:[], routeGroups:[], userAdded:true},
      fields
    );
    const afterId=document.getElementById('a-insert').value;
    if(afterId){
      const idx=lib.findIndex(r=>r.id===afterId);
      lib.splice(idx+1,0,newItem);
    } else {
      lib.push(newItem);
    }
    closeAdd(); render();
    flashMsg('\u2713 Added: '+name);
  }
}

// ── EXPORT / IMPORT / RESET ───────────────────────────────────────
function exportJSON(){
  const bundle = {library:lib, routes:routes};
  const blob=new Blob([JSON.stringify(bundle,null,2)],{type:'application/json'});
  const a=document.createElement('a');
  a.href=URL.createObjectURL(blob); a.download='heartbeat-database.json'; a.click();
  flashMsg('\u2713 Exported!');
}
function importJSON(e){
  const file=e.target.files[0]; if(!file) return;
  const reader=new FileReader();
  reader.onload=ev=>{
    try{
      const data=JSON.parse(ev.target.result);
      if(Array.isArray(data)){
        lib=data; render(); flashMsg('\u2713 Imported library (legacy format)!');
      } else if(data && Array.isArray(data.library)){
        lib = data.library;
        if(data.routes) routes = data.routes;
        render(); flashMsg('\u2713 Imported!');
      } else {
        alert('Invalid format — expected a JSON array or a {library, routes} object.');
      }
    }catch{alert('Could not parse JSON file.');}
  };
  reader.readAsText(file); e.target.value='';
}
function resetData(){
  if(!confirm('Reset to original data? All your additions and route edits will be lost.')) return;
  lib = JSON.parse(JSON.stringify(INITIAL_LIBRARY));
  routes = JSON.parse(JSON.stringify(INITIAL_ROUTES));
  localStorage.removeItem(STORAGE_KEY);
  localStorage.removeItem(ROUTES_STORAGE_KEY);
  render(); flashMsg('\u2713 Reset done');
}

// ── BOOT ──────────────────────────────────────────────────────────
loadData();
loadRoutes();
toggleAddFields();
render();

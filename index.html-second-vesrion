  const el=document.getElementById('save-msg');
  el.textContent=m; setTimeout(()=>el.textContent='',2500);
}

// ── FILTER ────────────────────────────────────────────────────────
function getFiltered(){
  let items = lib;
  if(filters.type!=='all') items=items.filter(i=>i.type===filters.type);
  if(filters.region)   items=items.filter(i=>i.region===filters.region);
  if(filters.priority) items=items.filter(i=>i.priority===filters.priority);
  if(filters.theme)    items=items.filter(i=>(i.themes||[]).includes(filters.theme));
  if(filters.search){
    const q=filters.search.toLowerCase();
    items=items.filter(i=>(i.name||'').toLowerCase().includes(q)||(i.state||'').toLowerCase().includes(q)||(i.notes||'').toLowerCase().includes(q)||(i.category||'').toLowerCase().includes(q)||((i.themes||[]).join(' ')).toLowerCase().includes(q));
  }
  return items;
}

// ── SCORE DOTS ───────────────────────────────────────────────────
function scoreDots(n, color){
  let h='';
  for(let i=1;i<=5;i++) h+=`<span class="dot ${i<=n?'on':'off'}" style="background:${i<=n?color:'#c8b0a0'}"></span>`;
  return h;
}

